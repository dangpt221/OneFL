# OneFL implemented runtime configuration. Preserve your existing .env.
ENV=development
DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SECRET_KEY=replace_with_a_random_secret_before_remote_use
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Required in production: random token with at least 24 characters.
API_ACCESS_TOKEN=
# Optional user ID -> token map. Existing projects belong to local.
AUTH_USERS={}

# One configured database; there is no fallback to a second database.
DATABASE_URL=sqlite+aiosqlite:///./onefl_videotrans.db
# Compose overrides DATABASE_URL to its postgres service.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_this_database_password
POSTGRES_DB=onefl_videotrans
POSTGRES_PORT=5432

# Only persistent local/mounted storage is implemented.
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
TEMP_SCRATCH_DIR=./tmp/scratch
CACHE_RETENTION_DAYS=14
MAX_UPLOAD_BYTES=64424509440
MAX_UPLOAD_CHUNK_BYTES=16777216
MAX_QUEUED_JOBS=100
JOB_POLL_SECONDS=1
JOB_LEASE_SECONDS=45

WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
ENABLE_SPEAKER_DIARIZATION=false
DIARIZATION_DEVICE=cpu
HF_TOKEN=
ENABLE_SPEAKER_PROFILER=true
ENABLE_VISUAL_CONTEXT=false

# Configure keys and models accessible to your account.
TRANSLATION_PRIMARY_PROVIDER=gemini
TRANSLATION_FALLBACK_PROVIDER=openai
ENABLE_AUTO_FALLBACK_ON_ERROR=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_CONCURRENCY=10
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_CONCURRENCY=10
LLM_BATCH_SIZE_LINES=40
LLM_CONTEXT_WINDOW_LINES=5
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=45

ENABLE_GUARDRAILS=true
GUARDRAIL_MAX_REFLEXION_RETRIES=2
GUARDRAIL_CHECK_PRONOUN_CONSISTENCY=true
GUARDRAIL_STRICT_GLOSSARY=true
MAX_SUBTITLE_LINE_LENGTH=40
MAX_SUBTITLE_LINES=2
MAX_CPS=20

FFMPEG_PATH=ffmpeg
VIDEO_CHUNK_DURATION_SECONDS=1200
MAX_CONCURRENT_GPU_BURN_WORKERS=2
NVENC_GPU_DEVICE_ID=0
NVENC_PRESET=p4
NVENC_CQ_LEVEL=23
BURN_OUTPUT_AUDIO_BITRATE=192k
DEFAULT_TTS_VOICE=vieneu-ngoc-huyen
DEFAULT_TTS_MODEL=tts-1
DEFAULT_TTS_SPEED=1.0
TTS_MAX_CONCURRENCY=8
DEFAULT_DUCKING_VOLUME=0.18

# Set before Next.js build (Docker uses http://backend:8000).
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
