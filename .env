# ==============================================================================
# ENVIRONMENT CONFIGURATION - AUTO VIDEO TRANSLATION & SUBTITLE BURNER
# Large Scale (10h+ Video Processing)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
ENV=development
DEBUG=true
APP_NAME="OneFl Video Translator"
APP_PORT=8000
APP_HOST=0.0.0.0
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SECRET_KEY=onefl_development_secret_key_32_characters_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Next.js Frontend URL (for Webhooks & CORS)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=onefl_videotrans
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/onefl_videotrans
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ------------------------------------------------------------------------------
# 3. REDIS & MESSAGE BROKER (Cache, Pub/Sub, Live Progress)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. OBJECT STORAGE (AWS S3 / Cloudflare R2 / MinIO)
# ------------------------------------------------------------------------------
STORAGE_DRIVER=s3
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY_ID=your_s3_or_r2_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_or_r2_secret_access_key
S3_BUCKET_NAME=onefl-video-bucket
S3_REGION=us-east-1
S3_PRESIGNED_EXPIRY_SECONDS=86400

# ------------------------------------------------------------------------------
# 5. ORCHESTRATION ENGINE (Temporal.io)
# ------------------------------------------------------------------------------
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=video-translation-main-queue
TEMPORAL_GPU_TASK_QUEUE=video-translation-gpu-queue

# ------------------------------------------------------------------------------
# 6. ASR & SPEAKER DIARIZATION (WhisperX + PyAnnote)
# ------------------------------------------------------------------------------
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_BEAM_SIZE=5
WHISPER_BATCH_SIZE=16
VAD_METHOD=silero
ENABLE_SPEAKER_DIARIZATION=true                   # Tách giọng người nói (SPEAKER_00, SPEAKER_01...)
ENABLE_SPEAKER_PROFILER=true                      # Tự động phân tích Giới tính, Tuổi tác, Quan hệ nhân vật
HF_TOKEN=your_huggingface_access_token_for_pyannote

# ------------------------------------------------------------------------------
# 7. TRANSLATION LLM API & GUARDRAILS CONFIGURATION (Multi-Provider: Gemini & OpenAI)
# ------------------------------------------------------------------------------
# Active Provider & Fallback Strategy
# Options: gemini | openai | anthropic | hybrid
TRANSLATION_PRIMARY_PROVIDER=gemini
TRANSLATION_FALLBACK_PROVIDER=openai
ENABLE_AUTO_FALLBACK_ON_ERROR=true                 # Tự động switch sang provider dự phòng nếu bị Rate Limit / Lỗi

# Translation Pipeline & Smart Chunking
DEFAULT_SOURCE_LANGUAGE=auto                      # en | zh | ja | ko | auto
DEFAULT_TARGET_LANGUAGE=vi
LLM_BATCH_SIZE_LINES=40                            # Số dòng sub gửi dịch trong 1 request chunk
LLM_CONTEXT_WINDOW_LINES=5                         # Số dòng ngữ cảnh trước đó gửi kèm
LLM_TEMPERATURE=0.3                                # Nhiệt độ sinh từ (0.1 - 0.4 tối ưu cho dịch chính xác)
LLM_TIMEOUT_SECONDS=45                             # Timeout mỗi request LLM
LLM_ENABLE_JSON_MODE=true                          # Ép LLM trả về format JSON cấu trúc chuẩn

# --- GUARDRAILS & QUALITY CONTROL SYSTEM ---
ENABLE_GUARDRAILS=true                             # Bật hệ thống kiểm soát chất lượng dịch
GUARDRAIL_MAX_REFLEXION_RETRIES=2                  # Số lần tự động phản xạ sửa lỗi (Fast Fix Loop)
GUARDRAIL_CHECK_PRONOUN_CONSISTENCY=true           # Kiểm tra độ nhất quán của đại từ xưng hô
GUARDRAIL_STRICT_GLOSSARY=true                     # Ép buộc sử dụng từ điển thuật ngữ
MAX_SUBTITLE_LINE_LENGTH=40                        # Giới hạn tối đa ký tự trên 1 dòng
MAX_SUBTITLE_LINES=2                               # Tối đa 2 dòng / 1 câu phụ đề
MAX_CPS=20                                         # Characters Per Second tối đa (Tốc độ đọc)

# --- MULTI-LANGUAGE PREFERENCES (EN, ZH, JA, KO -> VI) ---
ZH_TRANSLATION_STYLE=modern_vietnamese             # modern_vietnamese (phim hiện đại) | han_viet (cổ trang)
JA_KEIGO_SENSITIVITY=high                          # Nhận diện kính ngữ tiếng Nhật chuẩn mực
KO_HONORIFIC_SENSITIVITY=high                      # Nhận diện kính ngữ tiếng Hàn (Jondaetmal vs Banmal)

# ==============================================================================
# >>> CHỖ ĐIỀN API KEY CHO GOOGLE GEMINI & OPENAI <<<
# ==============================================================================

# --- [1] CẤU HÌNH & KEY GOOGLE GEMINI ---
# Lấy API Key miễn phí / trả phí tại: https://aistudio.google.com/app/apikey
# Định dạng Key bắt đầu bằng: AIzaSy...
GEMINI_API_KEY=AIzaSy_DIEN_API_KEY_GEMINI_CUA_BAN_VAO_DAY
GEMINI_MODEL=gemini-2.5-flash                      # gemini-2.5-flash (mới nhất, dịch cực chuẩn) | gemini-2.0-flash | gemini-1.5-pro
GEMINI_MAX_CONCURRENCY=10                          # Số luồng gửi song song
GEMINI_RPM_LIMIT=1000                              # Giới hạn request / phút

# --- [2] CẤU HÌNH & KEY OPENAI ---
# Lấy API Key tại: https://platform.openai.com/api-keys
# Định dạng Key bắt đầu bằng: sk-proj-... hoặc sk-...
OPENAI_API_KEY=sk-proj-DIEN_API_KEY_OPENAI_CUA_BAN_VAO_DAY
OPENAI_API_BASE=https://api.openai.com/v1          # Endpoint mặc định hoặc endpoint Azure OpenAI / Proxy
OPENAI_ORGANIZATION_ID=                            # (Tùy chọn) Điền Org ID nếu có
OPENAI_MODEL=gpt-4o-mini                           # gpt-4o-mini (nhanh, chuẩn, rẻ) | gpt-4o (cao cấp) | o3-mini
OPENAI_MAX_CONCURRENCY=10                          # Số luồng gửi song song
OPENAI_RPM_LIMIT=500                               # Giới hạn request / phút

# --- [3] CẤU HÌNH & KEY ANTHROPIC CLAUDE (DỰ PHÒNG TÙY CHỌN) ---
# Lấy API Key tại: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-DIEN_API_KEY_CLAUDE_CUA_BAN_VAO_DAY
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 8. DISTRIBUTED VIDEO CHUNKING & FFMPEG NVENC SETTINGS
# ------------------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TEMP_SCRATCH_DIR=./tmp/scratch

# Chunking Strategy for 10h Video
VIDEO_CHUNK_DURATION_SECONDS=1200
MAX_CONCURRENT_GPU_BURN_WORKERS=8
NVENC_GPU_DEVICE_ID=0
NVENC_PRESET=p4
NVENC_CQ_LEVEL=23
BURN_OUTPUT_AUDIO_BITRATE=192k

# Subtitle Styling Default (.ASS)
SUB_FONT_NAME=Roboto
SUB_FONT_SIZE=22
SUB_PRIMARY_COLOR=&H00FFFFFF
SUB_OUTLINE_COLOR=&H00000000
SUB_OUTLINE_WIDTH=2
SUB_SHADOW_DEPTH=1
SUB_MARGIN_BOTTOM=25

# ------------------------------------------------------------------------------
# 9. LOGGING & MONITORING
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
ENABLE_SENTRY=false
SENTRY_DSN=
